// To switch to PostgreSQL later:
// 1. Change provider to "postgresql"
// 2. Set DATABASE_URL to your Postgres/Supabase/Neon URL in .env
// 3. (Optional) Convert String fields (colors, specs, shippingAddress, addresses) to native Json
// 4. Run: npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id                String         @id @default(uuid())
  name              String
  slug              String         @unique
  brand             String         @default("Apple")
  category          String         // iPhone | iPad | Mac | Watch | AirPods | TV & Home | Accessories
  model             String?
  storage           String?        // 64GB | 128GB | 256GB | 512GB | 1TB | null
  colors            String         // JSON string: [{ name, hex, images: [] }]
  priceGHS          Float
  compareAtPriceGHS Float?
  stock             Int            @default(10)
  description       String
  specs             String         // JSON string: { display, chip, camera, battery, weight, etc. }
  warranty          String         @default("1 Year Apple Warranty")
  condition         String         @default("New") // "New" | "Refurbished"
  rating            Float          @default(5.0)
  reviewCount       Int            @default(0)
  featured          Boolean        @default(false)
  tags              String         @default("") // comma-separated, e.g. "new,featured,bestseller"
  isActive          Boolean        @default(true)
  displayOrder      Int            @default(0)
  images            ProductImage[]
  reviews           Review[]
  orderItems        OrderItem[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([category])
  @@index([featured])
  @@index([isActive, displayOrder])
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  url          String
  alt          String?
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  userId     String?
  authorName String
  rating     Int      // 1 to 5
  title      String
  body       String
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id               String      @id @default(uuid())
  userId           String?
  user             User?       @relation(fields: [userId], references: [id])
  items            OrderItem[]
  subtotalGHS      Float
  deliveryFeeGHS   Float       @default(25.0)
  totalGHS         Float
  deliveryRegion   String      // Greater Accra | Ashanti | Western | Eastern | etc.
  shippingAddress  String      // JSON string: { fullName, phone, region, city, gpsAddress, landmark }
  paymentReference String?     @unique
  paymentChannel   String?     // mobile_money | card | bank
  status           String      @default("pending") // pending | paid | shipped | delivered | cancelled
  notes            String?
  paidAt           DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentReference])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  name      String   // Snapshot at purchase time
  priceGHS  Float    // Snapshot at purchase time
  qty       Int      @default(1)
  color     String?  // Snapshot
  storage   String?  // Snapshot
  image     String?  // Snapshot URL
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  email     String?  @unique
  name      String
  addresses String   @default("[]") // JSON string: [{ fullName, phone, region, city, gpsAddress, landmark, isDefault }]
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
