// To switch to PostgreSQL later:
// 1. Change provider to "postgresql"
// 2. Set DATABASE_URL to your Postgres/Supabase/Neon URL in .env
// 3. (Optional) Convert String fields (colors, specs, shippingAddress, addresses) to native Json
// 4. Run: npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id                String         @id @default(uuid())
  name              String
  slug              String         @unique
  brand             String         @default("Apple")
  category          String         // iPhone | iPad | Mac | Watch | AirPods | TV & Home | Accessories
  model             String?
  storage           String?        // 64GB | 128GB | 256GB | 512GB | 1TB | null
  colors            String         // JSON string: [{ name, hex, images: [] }]
  priceGHS          Float
  compareAtPriceGHS Float?
  stock             Int            @default(10)
  description       String
  specs             String         // JSON string: { display, chip, camera, battery, weight, etc. }
  warranty          String         @default("1 Year Apple Warranty")
  condition         String         @default("New") // "New" | "Refurbished"
  rating            Float          @default(5.0)
  reviewCount       Int            @default(0)
  featured          Boolean        @default(false)
  tags              String         @default("") // comma-separated, e.g. "new,featured,bestseller"
  isActive          Boolean        @default(true)
  displayOrder      Int            @default(0)
  images            ProductImage[]
  reviews           Review[]
  orderItems        OrderItem[]
  wishlistItems     WishlistItem[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([category])
  @@index([featured])
  @@index([isActive, displayOrder])
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  url          String
  alt          String?
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  userId     String?
  authorName String
  rating     Int      // 1 to 5
  title      String
  body       String
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id               String      @id @default(uuid())
  userId           String?
  user             User?       @relation(fields: [userId], references: [id])
  items            OrderItem[]
  subtotalGHS      Float
  deliveryFeeGHS   Float       @default(25.0)
  totalGHS         Float
  deliveryRegion   String      // Greater Accra | Ashanti | Western | Eastern | etc.
  shippingAddress  String      // JSON string: { fullName, phone, region, city, gpsAddress, landmark }
  paymentReference String?     @unique
  paymentChannel   String?     // mobile_money | card | bank
  status           String      @default("pending") // pending | paid | shipped | delivered | cancelled
  notes            String?
  trackingNumber   String?
  courier          String?
  adminNote        String?
  paidAt           DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  isInstallment    Boolean     @default(false)
  installmentPlan  InstallmentPlan?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentReference])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  name      String   // Snapshot at purchase time
  priceGHS  Float    // Snapshot at purchase time
  qty       Int      @default(1)
  color     String?  // Snapshot
  storage   String?  // Snapshot
  image     String?  // Snapshot URL
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model User {
  id         String   @id @default(uuid())
  supabaseId String?  @unique
  phone      String   @unique
  email      String?  @unique
  name       String
  role       String   @default("customer") // "customer" | "admin"
  isActive   Boolean  @default(true)
  addresses  String   @default("[]") // JSON string: [{ fullName, phone, region, city, gpsAddress, landmark, isDefault }]
  orders     Order[]
  installmentPlans InstallmentPlan[]
  kycVerifications KycVerification[]
  wishlist   WishlistItem[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([role])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model KycVerification {
  id              String   @id @default(uuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  nationalId      String   // Ghana Card: GHA-XXXXXXXXX-X
  fullName        String
  dob             String?  // YYYY-MM-DD
  gender          String?
  phone           String?
  verifiedAt      DateTime @default(now())
  provider        String   @default("NIA") // NIA | IdentityPass | Prembly | simulated
  status          String   @default("verified") // verified | failed | pending
  photoUrl        String?
  rawResponse     String?  // Encrypted or JSON string
  plans           InstallmentPlan[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([nationalId])
  @@index([userId])
}

model InstallmentPlan {
  id                 String                @id @default(uuid())
  orderId            String                @unique
  order              Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?                 @relation(fields: [userId], references: [id])
  kycId              String?
  kyc                KycVerification?      @relation(fields: [kycId], references: [id])
  
  // Financial calculation breakdown
  totalAmountGHS     Float
  downPaymentPercent Float                 @default(60.0) // 60%
  downPaymentGHS     Float                 // 60% of total
  remainingGHS       Float                 // 40% of total
  frequency          String                // "weekly" | "monthly"
  totalInstallments  Int                   // e.g. 4 for weekly, 2 for monthly
  installmentAmountGHS Float               // remaining / totalInstallments
  
  // Applicant details
  applicantName      String
  applicantPhone     String
  applicantEmail     String?
  ghanaCardNumber    String                // GHA-XXXXXXXXX-X
  gpsAddress         String?
  occupation         String?
  employer           String?
  nextOfKinName      String?
  nextOfKinPhone     String?
  
  // Status and payments
  downPaymentPaid    Boolean               @default(false)
  downPaymentRef     String?               // Paystack reference for 60%
  status             String                @default("pending_downpayment") // pending_downpayment | active | completed | defaulted | cancelled
  milestones         InstallmentMilestone[]
  
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([userId])
  @@index([status])
  @@index([ghanaCardNumber])
}

model InstallmentMilestone {
  id               String          @id @default(uuid())
  planId           String
  plan             InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  milestoneIndex   Int             // 1, 2, 3, etc.
  dueDate          DateTime
  amountGHS        Float
  status           String          @default("pending") // pending | paid | overdue | waived
  paidAt           DateTime?
  paymentReference String?
  paymentChannel   String?
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([planId])
  @@index([status])
  @@index([dueDate])
}

