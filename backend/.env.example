PORT=5001
DATABASE_URL="postgresql://user:password@host:port/database"
DIRECT_URL="postgresql://user:password@host:port/database"
PAYSTACK_SECRET_KEY=sk_test_mock_developer_mode
PAYSTACK_PUBLIC_KEY=pk_test_mock_developer_mode
FRONTEND_URL=http://localhost:8081

# Supabase Auth & Storage
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Hardware verification (serial/IMEI lookups)
# Register at https://dash.imei.info/register/ , create an API key, then set:
IMEIINFO_API_KEY=
# Optional: pin the numeric service id from GET /api/service/services/ (auto-detected when empty)
IMEIINFO_SERVICE_ID=
# Optional: legacy api.imeicheck.net provider
IMEICHECK_API_KEY=
