{
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit",
    "source.sortMembers": "explicit"
  },
  "java.jdt.ls.java.home": "/Applications/Android Studio.app/Contents/jbr/Contents/Home",
  "java.configuration.updateBuildConfiguration": "disabled",
  "java.autobuild.enabled": false,
  "java.import.gradle.enabled": false,
  "java.import.gradle.wrapper.enabled": false,
  "java.import.maven.enabled": false,
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.expo/**"
  ],
  "gradle.autoDetect": "off",
  "gradle.nestedProjects": false,
  "gradle.projectOpenBehavior": "NotOpen",
  "gradle.focusedProjects": [
    "android"
  ],
  "kotlin.indexing.excludeDirectories": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.expo/**",
    "**/build/**"
  ],
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.expo/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.expo": true
  }
}
